        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.release-access",
        "fields": [
          {
            "name": "accessType",
            "label": "accessType",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/accessType",
            "description": "Kind of access point.",
            "type": "Category",
            "constraint": {
              "values": [
                "gate",
                "door",
                "elevator",
                "barrier",
                "parcel-room"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "delivery.notify-recipient",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.notify-recipient",
      "title": "Notify recipient",
      "group": "Recipient",
      "description": "Send a notification to the recipient.",
      "applicability": {
        "DRONE": "applicable",
        "ROBOT": "applicable",
        "VAN": "applicable",
        "BIKE": "applicable"
      },
      "semantics": {
        "completion": "immediate",
        "persistence": "none",
        "scope": [
          "waypoint",
          "segment"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Notify recipient",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.notify-recipient",
        "fields": [
          {
            "name": "event",
            "label": "event",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/event",
            "description": "Reason for the notification.",
            "type": "Category",
            "constraint": {
              "values": [
                "approaching",
                "arrived",
                "handover-ready",
                "delivered",
                "failed",
                "rescheduled"
              ]
            }
          },
          {
            "name": "leadTime",
            "label": "leadTime",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/leadTime",
            "description": "For `approaching`: expected time to arrival.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "s"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            }
          },
          {
            "name": "channel",
            "label": "channel",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/channel",
            "description": "Channel to use.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "app",
                "sms",
                "call",
                "email"
              ]
            },
            "value": "app"
          },
          {
            "name": "message",
            "label": "message",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/message",
            "description": "Free text to add.",
            "optional": true,
            "type": "Text"
          }
        ]
      }
    },
    {
      "id": "delivery.verify-recipient",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.verify-recipient",
      "title": "Verify recipient",
      "group": "Recipient",
      "description": "Check that the person present is the recipient.",
