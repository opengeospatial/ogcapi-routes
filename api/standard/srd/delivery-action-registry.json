              ]
            }
          },
          {
            "name": "ageCheck",
            "label": "ageCheck",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/ageCheck",
            "description": "Minimum age to be confirmed.",
            "optional": true,
            "type": "Count",
            "constraint": {
              "intervals": [
                [
                  0,
                  120
                ]
              ]
            }
          },
          {
            "name": "maxAttempts",
            "label": "maxAttempts",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/maxAttempts",
            "description": "Attempts allowed.",
            "optional": true,
            "type": "Count",
            "constraint": {
              "intervals": [
                [
                  1,
                  10
                ]
              ]
            },
            "value": 3
          }
        ]
      },
      "result": "Record {verified: Boolean, attempts: Count}."
    },
    {
      "id": "delivery.contact-recipient",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.contact-recipient",
      "title": "Contact recipient",
      "group": "Recipient",
      "description": "Open a voice or video session between the recipient and a remote operator.",
