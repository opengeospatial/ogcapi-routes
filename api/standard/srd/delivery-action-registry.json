    {
      "id": "delivery.handover",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.handover",
      "title": "Hand over parcel",
      "group": "Handover",
      "description": "Deliver the parcel by the chosen method.",
      "applicability": {
        "DRONE": "applicable",
        "ROBOT": "applicable",
        "VAN": "applicable",
        "BIKE": "applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "flight-critical"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Hand over parcel",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.handover",
        "fields": [
          {
            "name": "parcelId",
            "label": "parcelId",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/parcelId",
            "description": "Identifier of the parcel (barcode or order line).",
            "type": "Text"
          },
          {
            "name": "method",
            "label": "method",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/method",
            "description": "Where and how the parcel is left.",
            "type": "Category",
            "constraint": {
              "values": [
                "hand-to-recipient",
                "doorstep",
                "safe-place",
                "locker",
                "neighbour",
                "mailbox",
                "drop-zone",
                "winch-drop"
              ]
            }
          },
          {
            "name": "proof",
            "label": "proof",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/proof",
            "description": "Proof of delivery to capture.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "photo",
                "signature",
                "pin",
                "qr-code",
                "none"
              ]
            },
            "value": "photo"
          },
          {
            "name": "contactless",
            "label": "contactless",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/contactless",
            "description": "If true, no person-to-vehicle contact.",
            "optional": true,
            "type": "Boolean",
            "value": true
          },
          {
            "name": "compartment",
            "label": "compartment",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/compartment",
            "description": "Compartment or slot to open, for vehicles with several.",
            "optional": true,
            "type": "Count",
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            }
          }
        ]
      },
      "result": "Record {outcome: Category(delivered, refused, not-possible), proofRef: Text}.",
      "composedOf": [
        "payload.release",
        "payload.winch",
        "payload.gripper"
      ],
      "notes": "For winch-drop the vehicle lowers the parcel on a line (registry payload.winch, payload.release)."
    },
