      "parametersSchema": {
        "type": "DataRecord",
        "label": "Verify recipient",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.verify-recipient",
        "fields": [
          {
            "name": "method",
            "label": "method",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/method",
            "description": "Verification method.",
