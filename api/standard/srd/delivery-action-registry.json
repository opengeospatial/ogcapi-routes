{
  "registry": "Delivery Vehicle Action Registry",
  "version": "0.1.0-draft",
  "baseUri": "http://www.opengis.net/def/uxs-delivery/",
  "vehicleClasses": [
    "DRONE",
    "ROBOT",
    "VAN",
    "BIKE"
  ],
  "commonRegistry": "http://www.opengis.net/def/uxs-command/",
  "actions": [
    {
      "id": "delivery.arrive-at-stop",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.arrive-at-stop",
      "title": "Arrive at delivery stop",
      "group": "Stop",
      "description": "Reach the delivery point of a stop and become ready to hand over. Marks the start of the stop.",
      "applicability": {
        "DRONE": "applicable",
        "ROBOT": "applicable",
        "VAN": "applicable",
        "BIKE": "applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Arrive at delivery stop",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.arrive-at-stop",
        "fields": [
          {
            "name": "stopId",
            "label": "stopId",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/stopId",
            "description": "Identifier of the stop within the route.",
            "type": "Text"
          },
          {
            "name": "approachMode",
            "label": "approachMode",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/approachMode",
            "description": "How to reach the delivery point.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "curb",
                "door",
                "drop-point",
                "hover"
              ]
            },
            "value": "curb"
          },
          {
            "name": "toleranceRadius",
            "label": "toleranceRadius",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/toleranceRadius",
            "description": "Distance from the delivery point accepted as arrived.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "m"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            },
            "value": 10
          }
        ]
      },
      "composedOf": [
        "vehicle.goto"
      ]
    },
    {
      "id": "delivery.park",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.park",
      "title": "Park at stop",
      "group": "Stop",
      "description": "Park the vehicle legally and safely at the stop.",
      "applicability": {
        "DRONE": "limited",
        "ROBOT": "limited",
        "VAN": "applicable",
        "BIKE": "applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "flight-critical"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Park at stop",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.park",
        "fields": [
          {
            "name": "location",
            "label": "location",
            "definition": "http://www.opengis.net/def/uxs-command/type/Position",
            "description": "Parking position. If absent, the vehicle chooses near the delivery point. (type defined in the Common Command Registry)",
            "optional": true,
            "type": "DataRecord"
          },
          {
            "name": "parkingType",
            "label": "parkingType",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/parkingType",
            "description": "Kind of parking.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "curb",
                "loading-bay",
                "bike-rack",
                "stand-off"
              ]
            },
            "value": "curb"
          },
          {
            "name": "maxDuration",
            "label": "maxDuration",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/maxDuration",
            "description": "Maximum parking time.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "s"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            }
          }
        ]
      },
      "composedOf": [
        "vehicle.stop"
      ]
    },
    {
      "id": "delivery.hold-for-recipient",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.hold-for-recipient",
      "title": "Wait for recipient",
      "group": "Stop",
      "description": "Wait at the stop for the recipient to arrive.",
      "applicability": {
        "DRONE": "applicable",
        "ROBOT": "applicable",
        "VAN": "applicable",
        "BIKE": "applicable"
      },
      "semantics": {
        "completion": "until-duration",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Wait for recipient",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.hold-for-recipient",
        "fields": [
          {
            "name": "maxWait",
            "label": "maxWait",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/maxWait",
            "description": "Longest wait.",
            "type": "Quantity",
            "uom": {
              "code": "s"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            }
          },
          {
            "name": "onTimeout",
            "label": "onTimeout",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/onTimeout",
            "description": "What to do when the wait expires.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "fail-stop",
                "safe-place",
                "return-to-depot",
                "next-stop"
              ]
            },
            "value": "fail-stop"
          }
        ]
      },
      "composedOf": [
        "mission.wait",
        "vehicle.hold-position"
      ]
    },
    {
      "id": "delivery.depart-stop",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.depart-stop",
      "title": "Depart from stop",
      "group": "Stop",
      "description": "Close the stop and resume the route.",
      "applicability": {
        "DRONE": "applicable",
        "ROBOT": "applicable",
        "VAN": "applicable",
        "BIKE": "applicable"
      },
      "semantics": {
        "completion": "immediate",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Depart from stop",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.depart-stop",
        "fields": [
          {
            "name": "stopId",
            "label": "stopId",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/stopId",
            "description": "Identifier of the stop.",
            "type": "Text"
          },
          {
            "name": "outcome",
            "label": "outcome",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/outcome",
            "description": "Result of the stop.",
            "type": "Category",
            "constraint": {
              "values": [
                "delivered",
                "failed",
                "skipped",
                "returned"
              ]
            }
          }
        ]
      },
      "composedOf": [
        "vehicle.undock"
      ]
    },
    {
      "id": "delivery.request-access",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.request-access",
      "title": "Request access to a site",
      "group": "Access",
      "description": "Obtain access through a gate, door, barrier or lift.",
      "applicability": {
        "DRONE": "limited",
        "ROBOT": "applicable",
        "VAN": "applicable",
        "BIKE": "limited"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "mode",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Request access to a site",
        "definition": "http://www.opengis.net/def/uxs-delivery/delivery.request-access",
        "fields": [
          {
            "name": "accessType",
            "label": "accessType",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/accessType",
            "description": "Kind of access point.",
            "type": "Category",
            "constraint": {
              "values": [
                "gate",
                "door",
                "elevator",
                "barrier",
                "parcel-room"
              ]
            }
          },
          {
            "name": "credential",
            "label": "credential",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/credential",
            "description": "Reference of an access code or token (never the secret itself).",
            "optional": true,
            "type": "Text"
          },
          {
            "name": "timeout",
            "label": "timeout",
            "definition": "http://www.opengis.net/def/uxs-delivery/param/timeout",
            "description": "Longest time to wait for access.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "s"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            },
            "value": 120
          }
        ]
      },
      "result": "Record {granted: Boolean, message: Text}."
    },
    {
      "id": "delivery.release-access",
      "uri": "http://www.opengis.net/def/uxs-delivery/delivery.release-access",
      "title": "Release access",
      "group": "Access",
      "description": "Close or release a previously requested access.",
      "applicability": {
        "DRONE": "limited",
        "ROBOT": "applicable",
