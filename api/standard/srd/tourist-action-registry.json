    {
      "id": "tour.set-assist-level",
      "uri": "http://www.opengis.net/def/uxs-tour/tour.set-assist-level",
      "title": "Set assist level",
      "group": "Riding",
      "description": "Set the motor assistance of an e-bike.",
      "applicability": {
        "EBIKE": "applicable",
        "ESCOOTER": "not-applicable",
        "WALK": "not-applicable",
        "TRANSIT": "not-applicable"
      },
      "semantics": {
        "completion": "immediate",
        "persistence": "latched",
        "scope": [
          "waypoint",
          "segment",
          "route"
        ],
        "hazard": "none",
        "revert": "restore previous assist level"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Set assist level",
        "definition": "http://www.opengis.net/def/uxs-tour/tour.set-assist-level",
