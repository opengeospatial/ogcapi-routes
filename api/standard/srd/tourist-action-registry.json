{
  "registry": "Tourist Route Action Registry",
  "version": "0.1.0-draft",
  "baseUri": "http://www.opengis.net/def/uxs-tour/",
  "vehicleClasses": [
    "EBIKE",
    "ESCOOTER",
    "WALK",
    "TRANSIT"
  ],
  "commonRegistry": "http://www.opengis.net/def/uxs-command/",
  "actions": [
    {
      "id": "tour.find-vehicle",
      "uri": "http://www.opengis.net/def/uxs-tour/tour.find-vehicle",
      "title": "Find a vehicle",
      "group": "Vehicles",
      "description": "Locate and reserve an available shared vehicle near a position.",
      "applicability": {
        "EBIKE": "applicable",
        "ESCOOTER": "applicable",
        "WALK": "not-applicable",
        "TRANSIT": "not-applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Find a vehicle",
        "definition": "http://www.opengis.net/def/uxs-tour/tour.find-vehicle",
        "fields": [
          {
            "name": "vehicleType",
            "label": "vehicleType",
            "definition": "http://www.opengis.net/def/uxs-tour/param/vehicleType",
            "description": "Type of vehicle.",
            "type": "Category",
            "constraint": {
              "values": [
                "ebike",
                "escooter",
                "cargo-ebike",
                "any"
              ]
            }
          },
          {
            "name": "searchRadius",
            "label": "searchRadius",
            "definition": "http://www.opengis.net/def/uxs-tour/param/searchRadius",
            "description": "Maximum walking distance to the vehicle.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "m"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            },
            "value": 300
          },
          {
            "name": "minBattery",
            "label": "minBattery",
            "definition": "http://www.opengis.net/def/uxs-tour/param/minBattery",
            "description": "Minimum state of charge.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "%"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  100
                ]
              ]
            },
            "value": 40
          },
          {
            "name": "reserveFor",
            "label": "reserveFor",
            "definition": "http://www.opengis.net/def/uxs-tour/param/reserveFor",
            "description": "Reservation time.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "s"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  1800
                ]
              ]
            },
            "value": 600
          },
          {
            "name": "operator",
            "label": "operator",
            "definition": "http://www.opengis.net/def/uxs-tour/param/operator",
            "description": "Operator or system id (for example a bike-share system id).",
            "optional": true,
            "type": "Text"
          }
        ]
      },
      "result": "Record {vehicleId: Text, location: Position, battery: Quantity %}."
    },
    {
      "id": "tour.unlock-vehicle",
      "uri": "http://www.opengis.net/def/uxs-tour/tour.unlock-vehicle",
      "title": "Unlock vehicle",
      "group": "Vehicles",
      "description": "Unlock a reserved or found vehicle and start the rental.",
      "applicability": {
        "EBIKE": "applicable",
        "ESCOOTER": "applicable",
        "WALK": "not-applicable",
        "TRANSIT": "not-applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "mode",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Unlock vehicle",
        "definition": "http://www.opengis.net/def/uxs-tour/tour.unlock-vehicle",
        "fields": [
          {
            "name": "vehicleId",
            "label": "vehicleId",
            "definition": "http://www.opengis.net/def/uxs-tour/param/vehicleId",
            "description": "Identifier of the vehicle. If absent, the vehicle returned by the preceding `tour.find-vehicle`.",
            "optional": true,
            "type": "Text"
          },
          {
            "name": "method",
            "label": "method",
            "definition": "http://www.opengis.net/def/uxs-tour/param/method",
            "description": "How to unlock.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "app",
                "qr-code",
                "nfc",
                "pin"
              ]
            },
            "value": "app"
          }
        ]
      },
      "result": "Record {unlocked: Boolean, startTime: Time}."
    },
    {
      "id": "tour.lock-vehicle",
      "uri": "http://www.opengis.net/def/uxs-tour/tour.lock-vehicle",
      "title": "Lock vehicle",
      "group": "Vehicles",
      "description": "Lock the vehicle temporarily (stop at a point of interest) without ending the rental.",
      "applicability": {
        "EBIKE": "applicable",
        "ESCOOTER": "applicable",
        "WALK": "not-applicable",
        "TRANSIT": "not-applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "mode",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Lock vehicle",
        "definition": "http://www.opengis.net/def/uxs-tour/tour.lock-vehicle",
        "fields": [
          {
            "name": "vehicleId",
            "label": "vehicleId",
            "definition": "http://www.opengis.net/def/uxs-tour/param/vehicleId",
            "description": "Identifier of the vehicle. If absent, the vehicle in use.",
            "optional": true,
            "type": "Text"
          },
          {
            "name": "lockType",
            "label": "lockType",
            "definition": "http://www.opengis.net/def/uxs-tour/param/lockType",
            "description": "Lock type.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "cable",
                "frame",
                "wheel",
                "virtual"
              ]
            },
            "value": "frame"
          }
        ]
      }
    },
    {
      "id": "tour.return-vehicle",
      "uri": "http://www.opengis.net/def/uxs-tour/tour.return-vehicle",
      "title": "Return vehicle",
      "group": "Vehicles",
      "description": "End the rental by parking and locking the vehicle where permitted.",
      "applicability": {
        "EBIKE": "applicable",
        "ESCOOTER": "applicable",
        "WALK": "not-applicable",
        "TRANSIT": "not-applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Return vehicle",
        "definition": "http://www.opengis.net/def/uxs-tour/tour.return-vehicle",
        "fields": [
          {
            "name": "vehicleId",
            "label": "vehicleId",
            "definition": "http://www.opengis.net/def/uxs-tour/param/vehicleId",
            "description": "Identifier of the vehicle. If absent, the vehicle in use.",
            "optional": true,
            "type": "Text"
          },
          {
            "name": "stationId",
            "label": "stationId",
            "definition": "http://www.opengis.net/def/uxs-tour/param/stationId",
            "description": "Docking station, for station-based systems.",
            "optional": true,
            "type": "Text"
          },
          {
            "name": "parkingZone",
            "label": "parkingZone",
            "definition": "http://www.opengis.net/def/uxs-tour/param/parkingZone",
            "description": "Where the vehicle is left.",
            "optional": true,
            "type": "Category",
            "constraint": {
              "values": [
                "station",
                "designated-zone",
                "free-floating"
              ]
            },
            "value": "station"
          },
          {
            "name": "photoProof",
            "label": "photoProof",
            "definition": "http://www.opengis.net/def/uxs-tour/param/photoProof",
            "description": "Capture a photo of the parked vehicle.",
            "optional": true,
            "type": "Boolean",
            "value": false
          }
        ]
      },
      "result": "Record {returned: Boolean, cost: Quantity, currency: Text}."
    },
    {
      "id": "tour.switch-vehicle",
      "uri": "http://www.opengis.net/def/uxs-tour/tour.switch-vehicle",
      "title": "Switch vehicle",
      "group": "Vehicles",
      "description": "Change from one means of travel to another at a transfer point (includes walking).",
      "applicability": {
        "EBIKE": "applicable",
        "ESCOOTER": "applicable",
        "WALK": "applicable",
        "TRANSIT": "applicable"
      },
      "semantics": {
        "completion": "until-goal",
        "persistence": "none",
        "scope": [
          "waypoint"
        ],
        "hazard": "none"
      },
      "parametersSchema": {
        "type": "DataRecord",
        "label": "Switch vehicle",
        "definition": "http://www.opengis.net/def/uxs-tour/tour.switch-vehicle",
        "fields": [
          {
            "name": "from",
            "label": "from",
            "definition": "http://www.opengis.net/def/uxs-tour/param/from",
            "description": "Means of travel used so far.",
            "type": "Category",
            "constraint": {
              "values": [
                "ebike",
                "escooter",
                "walk",
                "transit"
              ]
            }
          },
          {
            "name": "to",
            "label": "to",
            "definition": "http://www.opengis.net/def/uxs-tour/param/to",
            "description": "Means of travel to use next.",
            "type": "Category",
            "constraint": {
              "values": [
                "ebike",
                "escooter",
                "walk",
                "transit"
              ]
            }
          },
          {
            "name": "transferTime",
            "label": "transferTime",
            "definition": "http://www.opengis.net/def/uxs-tour/param/transferTime",
            "description": "Estimated transfer time.",
            "optional": true,
            "type": "Quantity",
            "uom": {
              "code": "s"
            },
            "constraint": {
              "intervals": [
                [
                  0,
                  "Infinity"
                ]
              ]
            }
          }
        ]
      },
      "notes": "Composite of tour.return-vehicle, tour.find-vehicle and tour.unlock-vehicle."
    },
    {
